# Django
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
DEBUG=False

# List one canonical host only. Adding both apex and www lets a form render on one
# host submit to the other, which passes the origin check but fails on the
# host-only CSRF cookie.
ALLOWED_HOSTS=yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Database (parsed by dj-database-url; SSL is required, so SQLite will not connect)
DATABASE_URL=postgres://ecommerce:secure-random-password-here@localhost:5432/ecommerce

# Images storage. settings.py forces secure=True, so HTTPS URLs are generated even
# though this may omit ?secure=true.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Transport security. Defaults shown; override only when a deployment needs it.
# SECURE_SSL_REDIRECT=True
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=True
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Optional: Email settings
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=your-email@example.com

# Optional: Redis for caching/sessions (if needed)
# REDIS_URL=redis://localhost:6379/0